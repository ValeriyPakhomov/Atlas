# Atlas local configuration. Copy to .env; never commit .env.
# Secrets belong in a provider secret manager outside local development (SECURITY.md).

ATLAS_ENVIRONMENT=local
ATLAS_OWNER_TIMEZONE=Europe/Istanbul
ATLAS_BASE_CURRENCY=USD

# Matches docker-compose.yml
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
# Direct URL is used by Alembic and logical backup/restore workflows. In local Docker it
# matches the runtime URL; on Neon it must be the unpooled connection string.
ATLAS_DATABASE_DIRECT_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_TEST_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5433/atlas_test

# ATLAS_EXECUTION_ENABLED is deliberately absent. Atlas V1 is read-only (ADR-0003)
# and rejects any attempt to set it.

# --- Provider credentials (added by the queue items that use them) ---
# Read-only keys only. Never store seed phrases, private keys, withdrawal secrets
# or banking passwords in this file or anywhere else in the repository.
# ATLAS_FRED_API_KEY=
# ATLAS_OPENAI_API_KEY=
# ATLAS_ANTHROPIC_API_KEY=
# ATLAS_TELEGRAM_BOT_TOKEN=
